# Development defaults for the local stack (compose.yaml).
# Copy to .env and adjust. Never commit .env.
#
# These names are the contract: docs and later features cite them rather than inventing
# their own (`docs/SPEC_GUIDELINE.md` forbids inventing ports and variables elsewhere).

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
APP_VERSION=0.0.0

# --- Web ---
WEB_PORT=5173

# --- PostgreSQL (feature 03 owns the schema) ---
POSTGRES_USER=rpg
POSTGRES_PASSWORD=rpg_dev_password
POSTGRES_DB=rpg
POSTGRES_PORT=5432
DATABASE_URL=postgres://rpg:rpg_dev_password@localhost:5432/rpg

# --- MinIO / S3-compatible object storage (feature 05 owns the layout) ---
MINIO_ROOT_USER=rpg
MINIO_ROOT_PASSWORD=rpg_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
