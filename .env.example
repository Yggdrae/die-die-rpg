# Development defaults for the local stack (compose.yaml).
# Copy to .env and adjust. Never commit .env.
#
# These names are the contract: docs and later features cite them rather than inventing
# their own (`docs/SPEC_GUIDELINE.md` forbids inventing ports and variables elsewhere).

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
APP_VERSION=0.0.0

# --- Web ---
WEB_PORT=5173

# --- PostgreSQL (feature 03 owns the schema) ---
POSTGRES_USER=rpg
POSTGRES_PASSWORD=rpg_dev_password
POSTGRES_DB=rpg
POSTGRES_PORT=5432
DATABASE_URL=postgres://rpg:rpg_dev_password@localhost:5432/rpg
# Feature 06 audit retention (365 days). Only the exact value `true` lets the API and the
# retention CLI delete expired, fully acknowledged audit rows; the DATABASE_URL role must then be
# a member of `rpg_audit_maintenance`. Keep `false` unless an operator decides otherwise.
AUDIT_RETENTION_DELETE=false

# --- PowerSync replication role (migration 0006 creates the role; compose sets the password) ---
# Dev-only default. Deploys set their own secret; URL-encode it if it has reserved characters.
POWERSYNC_REPLICATION_PASSWORD=powersync_replication_dev_password

# --- MinIO / S3-compatible object storage (feature 05 owns the layout) ---
MINIO_ROOT_USER=rpg
MINIO_ROOT_PASSWORD=rpg_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Private attachment bucket and its least-privilege signing user (compose one-shot
# `minio-bucket` creates both). The API signs URLs with these, never with the root user.
S3_BUCKET=rpg-attachments
S3_ACCESS_KEY_ID=rpg-attachments
S3_SECRET_ACCESS_KEY=rpg_attachments_dev_secret
# Browser origins allowed to PUT/GET signed URLs (MinIO server-wide CORS allowlist).
S3_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:4173
