      },
      {
        "id": "taking_action",
        "title": "Taking action: dice and the ladder",
        "category": "core_mechanics",
        "references": ["four_actions"]
      },
      {
        "id": "four_actions",
        "title": "The four actions",
        "category": "core_mechanics",
        "references": ["resolving_attacks"]
      },
      {
        "id": "resolving_attacks",
