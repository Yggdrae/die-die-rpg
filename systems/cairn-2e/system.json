{
  "contractVersion": 1,
  "manifest": {
    "ref": { "systemId": "cairn-2e", "version": "1.0.0" },
    "name": "Cairn 2e",
    "shortDescription": "Rules-light adventure play: three attributes, saves, hit protection that gives way to attributes, and slot inventory.",
    "complexity": "low",
    "languages": ["en"],
    "integration": {
      "mechanicsSupported": true,
      "characterSheetSupported": true,
      "rulesTextIntegrated": false,
      "compendiumIntegrated": false,
      "externalDocumentation": "https://cairnrpg.com/second-edition/players-guide/core-rules/"
    },
    "license": {
      "license": "CC BY-SA 4.0",
      "source": "https://cairnrpg.com/second-edition/",
      "version": "4.0",
      "attribution": "Mechanics declared from Cairn Second Edition by Yochai Gal, whose text is licensed under CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/). This declaration is shared under the same licence. Not affiliated with or endorsed by the author.",
      "redistributionStatus": "allowed",
      "translationStatus": "allowed",
      "brandUsageStatus": "review-required",
      "assets": {
        "rulesText": "allowed",
        "mechanics": "allowed",
        "officialArtwork": "forbidden",
        "officialLogo": "forbidden"
      }
    },
    "rulesEntryPoint": "https://cairnrpg.com/second-edition/players-guide/core-rules/",
    "compatibleModules": []
  },
  "capabilities": [
    "character_sheet",
    "dice_rolls",
    "resource_pools",
    "conditions",
    "inventory_slots"
  ],
  "characterSchema": {
    "fields": [
      { "key": "name", "label": "Name", "group": "identity", "type": "text", "maxLength": 80 },
      {
        "key": "background",
        "label": "Background",
        "group": "identity",
        "type": "text",
        "maxLength": 120
      },
      { "key": "traits", "label": "Traits", "group": "identity", "type": "list" },
      {
        "key": "STR",
        "label": "Strength",
        "group": "attributes",
        "type": "number",
        "min": 0,
        "default": 10
      },
      {
        "key": "DEX",
        "label": "Dexterity",
        "group": "attributes",
        "type": "number",
        "min": 0,
        "default": 10
      },
      {
        "key": "WIL",
        "label": "Willpower",
        "group": "attributes",
        "type": "number",
        "min": 0,
        "default": 10
      },
      {
        "key": "hp_max",
        "label": "Maximum HP",
        "group": "protection",
        "type": "number",
        "min": 0,
        "default": 3
      },
      {
        "key": "hp",
        "label": "HP",
        "group": "protection",
        "type": "resource",
        "resourceKey": "hp"
      },
      {
        "key": "armor",
        "label": "Armor",
        "group": "protection",
        "type": "number",
        "min": 0,
        "max": 3,
        "default": 0
      },
      {
        "key": "gold",
        "label": "Gold",
        "group": "gear",
        "type": "counter",
        "min": 0,
        "default": 0
      },
      {
        "key": "pack",
        "label": "Inventory",
        "group": "gear",
        "type": "inventory",
        "inventoryKey": "pack"
      },
      {
        "key": "spellbooks",
        "label": "Spellbooks",
        "group": "gear",
        "type": "repeater",
        "of": [
          { "key": "spell", "label": "Spell", "group": "gear", "type": "text", "maxLength": 120 },
          { "key": "notes", "label": "Notes", "group": "gear", "type": "rich_text" }
        ]
      },
      { "key": "afflictions", "label": "Conditions", "group": "status", "type": "condition" }
    ],
    "summaryFields": ["name", "hp", "STR"]
  },
  "resources": [
    {
      "key": "hp",
      "label": "HP",
      "shape": "pool",
      "min": 0,
      "max": { "formula": "hp_max" },
      "default": { "formula": "hp_max" },
      "temporary": false,
      "visibility": "everyone",
      "spendable": false,
      "recovery": [{ "trigger": "brief_rest", "label": "A brief rest restores it" }]
    }
  ],
  "actions": [
    {
      "key": "save",
      "label": "Save",
      "roll": { "dice": "1d20" },
      "inputs": ["STR", "DEX", "WIL"],
      "picks": [{ "name": "attribute", "label": "Attribute", "fields": ["STR", "DEX", "WIL"] }],
      "outcomes": [
        {
          "id": "natural_one",
          "label": "A 1 always succeeds",
          "when": { "formula": "natural == 1" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        {
          "id": "natural_twenty",
          "label": "A 20 always fails",
          "when": { "formula": "natural == 20" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        {
          "id": "success",
          "label": "Success",
          "when": { "formula": "roll <= attribute" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        { "id": "failure", "label": "Failure", "resolution": { "mode": "apply", "effects": [] } }
      ]
    },
    {
      "key": "critical_damage_save",
      "label": "Strength save against critical damage",
      "roll": { "dice": "1d20" },
      "inputs": ["STR"],
      "outcomes": [
        {
          "id": "natural_one",
          "label": "A 1 always succeeds",
          "when": { "formula": "natural == 1" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        {
          "id": "natural_twenty",
          "label": "A 20 always fails: critical damage",
          "when": { "formula": "natural == 20" },
          "resolution": {
            "mode": "apply",
            "effects": [{ "effect": "add_condition", "params": { "condition": "critical_damage" } }]
          }
        },
        {
          "id": "success",
          "label": "Success",
          "when": { "formula": "roll <= STR" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        {
          "id": "failure",
          "label": "Critical damage",
          "resolution": {
            "mode": "apply",
            "effects": [{ "effect": "add_condition", "params": { "condition": "critical_damage" } }]
          }
        }
      ]
    },
    {
      "key": "take_damage_d4",
      "label": "Take d4 damage",
      "roll": { "dice": "1d4" },
      "inputs": ["armor", "STR", "hp"],
      "outcomes": [
        {
          "id": "deflected",
          "label": "Armor stops it",
          "when": { "formula": "roll - min(armor, 3) <= 0" },
          "resolution": { "mode": "apply", "effects": [] }
        },
        {
          "id": "fatal",
          "label": "Past HP, and Strength reaches 0",
          "when": { "formula": "roll - min(armor, 3) - hp >= STR" },
          "resolution": {
            "mode": "apply",
            "effects": [
              {
                "effect": "apply_damage",
                "params": { "resource": "hp", "amount": { "formula": "hp" } }
              },
              {
                "effect": "modify_field",
                "params": { "field": "STR", "amount": { "formula": "hp + min(armor, 3) - roll" } }
              },
              { "effect": "add_condition", "params": { "condition": "dead" } }
            ]
          }
        },
        {
          "id": "spills",
          "label": "Past HP, into Strength",
          "when": { "formula": "roll - min(armor, 3) > hp" },
          "resolution": {
            "mode": "apply",
            "effects": [
              {
                "effect": "apply_damage",
                "params": { "resource": "hp", "amount": { "formula": "hp" } }
              },
              {
                "effect": "modify_field",
                "params": { "field": "STR", "amount": { "formula": "hp + min(armor, 3) - roll" } }
              },
              { "effect": "execute_roll", "params": { "action": "critical_damage_save" } }
            ]
          }
        },
        {
          "id": "scar",
          "label": "Exactly to 0 HP: a scar",
          "when": { "formula": "roll - min(armor, 3) == hp" },
          "resolution": {
            "mode": "apply",
            "effects": [
              {
                "effect": "apply_damage",
                "params": { "resource": "hp", "amount": { "formula": "roll - min(armor, 3)" } }
              },
              { "effect": "add_condition", "params": { "condition": "scar" } }
            ]
          }
        },
        {
          "id": "absorbed",
          "label": "HP absorbs it",
          "resolution": {
            "mode": "apply",
            "effects": [
              {
                "effect": "apply_damage",
                "params": { "resource": "hp", "amount": { "formula": "roll - min(armor, 3)" } }
              }
            ]
          }
        }
      ]
    },
