{
  "name": "@rpg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist && bun ../../tools/guard/src/bundle-check.ts api dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
