{
  "name": "@rpg/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:assets": "bun ../../packages/sync/scripts/copy-browser-assets.mjs",
    "predev": "bun run sync:assets",
    "prebuild": "bun run sync:assets",
    "dev": "vite",
    "build": "vite build && bun ../../tools/guard/src/bundle-check.ts web dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rpg/actions": "workspace:*",
    "@rpg/attachments": "workspace:*",
    "@rpg/authorization": "workspace:*",
    "@rpg/campaign-portability": "workspace:*",
    "@rpg/campaigns": "workspace:*",
    "@rpg/characters": "workspace:*",
    "@rpg/encounters": "workspace:*",
    "@rpg/rules": "workspace:*",
    "@rpg/search": "workspace:*",
    "@rpg/sessions": "workspace:*",
    "@rpg/content": "workspace:*",
    "@rpg/dice": "workspace:*",
    "@rpg/contracts": "workspace:*",
    "@rpg/fixtures": "workspace:*",
    "@rpg/formula": "workspace:*",
    "@rpg/identity": "workspace:*",
    "@rpg/installed-systems": "workspace:*",
    "@rpg/sync": "workspace:*",
    "@rpg/systems": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "postgres": "^3.4.9",
    "vite": "^7.1.13",
    "vite-plugin-pwa": "^1.0.4",
    "@rpg/config": "workspace:*"
  }
}
